{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minha-semana-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "observability": { "enabled": true },
  "vars": {
    // Quadro da dona do plano. O mesmo valor do `PLANNER_QUADRO_ID` usado no
    // provisionamento e no token de serviço.
    "QUADRO_ID": "00000000-0000-0000-0000-000000000001",
    // Origens que podem chamar a API com cookie. Allowlist exata, sem curinga.
    "ORIGENS_PERMITIDAS": "https://minha-semana.quarto-de-milha.workers.dev,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081"
  }
}
